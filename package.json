{
  "name": "ruleaks-foottracker",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c green,cyan \"npm run dev -w @ft/server\" \"npm run dev -w @ft/web\"",
    "build": "npm run build -w @ft/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db": "npm run migrate -w @ft/db --",
    "password-hash": "node packages/config/src/password-hash.ts",
    "scans-check": "npm run scans-check -w @ft/server --",
    "pages-sites-update": "npm run pages-sites-update -w @ft/server",
    "pages-email-update": "npm run pages-email-update -w @ft/server",
    "login-link": "npm run login-link -w @ft/server --"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2"
  }
}
